config_version=5

[application]

config/name="Virelune"
run/main_scene="res://title_screen/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ArduinoMage="*uid://dyvllyjep8pyu"
